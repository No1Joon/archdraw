{
  "name": "@archdraw/core",
  "version": "0.15.0",
  "description": "Parse, validate, lay out and render cloud architecture diagrams as SVG.",
  "keywords": [
    "architecture-diagram",
    "diagram-as-code",
    "cloud-architecture",
    "diagram",
    "svg",
    "layout",
    "elk",
    "yaml",
    "react",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/No1Joon/archdraw.git",
    "directory": "packages/core"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./input": {
      "types": "./dist/input.d.mts",
      "default": "./dist/input.mjs"
    }
  },
  "files": [
    "dist",
    "NOTICE",
    "licenses"
  ],
  "scripts": {
    "build": "tsx ../../scripts/build-viewer.ts && tsdown src/index.ts src/input.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "elkjs": "0.12.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "react": ">=19",
    "react-dom": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
