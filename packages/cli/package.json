{
  "name": "archdraw",
  "version": "0.0.0",
  "description": "Render cloud architecture diagrams from YAML or a prompt.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "archdraw": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/cli.ts --format esm --clean",
    "typecheck": "tsc --noEmit"
