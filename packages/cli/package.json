  "dependencies": {
    "@archdraw/ai": "workspace:*",
    "@archdraw/core": "workspace:*",
    "@archdraw/icons-aws": "workspace:*",
    "@archdraw/icons-gcp": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "commander": "15.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "2.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
