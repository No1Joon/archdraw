{
  "name": "archdraw",
  "version": "0.6.0",
  "description": "Render cloud architecture diagrams from YAML. Built for AI CLIs and humans.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/No1Joon/archdraw.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "archdraw": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "fonts"
  ],
  "scripts": {
    "build": "tsdown src/cli.ts --format esm --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@archdraw/core": "workspace:*",
    "@archdraw/icons-aws": "workspace:*",
    "@archdraw/icons-brands": "workspace:*",
    "@archdraw/icons-gcp": "workspace:*",
    "@resvg/resvg-js": "2.6.2",
    "commander": "15.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
