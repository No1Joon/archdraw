{
  "name": "@archdraw/icons-aws",
  "version": "0.2.2",
  "description": "AWS Architecture Icons packaged as an archdraw icon pack.",
  "keywords": [
    "aws",
    "aws-icons",
    "architecture-icons",
    "cloud-icons",
    "icons",
    "svg",
    "architecture-diagram",
    "diagram-as-code"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/No1Joon/archdraw.git",
    "directory": "packages/icons-aws"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  }
}
